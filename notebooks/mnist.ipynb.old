   "id": "ea1cb1e0-54ce-437d-b4ee-64404de85310",
   "metadata": {},
   "outputs": [],
   "source": [
    "model_polling = SimpleMNISTCNN().to(DEVICE)\n",
    "optim_polling = torch.optim.Adam(\n",
    "    model_polling.parameters(),\n",
    "    lr=model_hyperparameters.lr,\n",
    "    weight_decay=model_hyperparameters.weight_decay,\n",
    ")\n"
   ]
  },
